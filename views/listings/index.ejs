<% layout("/layouts/boilerplate") %>

    <body>
        <style>
            #filters {
                display: flex;
                flex-wrap: wrap;
                align-items: center;
            }

            .filter {
                text-align: center;
                margin-top: 2rem;
                margin-right: 2rem;
                opacity: 0.7;
                cursor: pointer;
            }

            .filter:hover {
                opacity: 1;
            }

            .filter p {
                font-size: 0.8rem;
            }
            .tax-info{
                display: none;
            }
            .tax-toggle{
                border: 1px solid black;
                border-radius: 1rem;
                height: 3.25rem;
                padding: 1rem;
                display: flex;
                align-items: center;
            }
            /* Active category highlight */
            .filter-active {
                opacity: 1;
                border-bottom: 2px solid black;
                padding-bottom: 0.2rem;
            }
            .filter-active p {
                font-weight: 600;
            }
            /* Right-side controls: sort + tax toggle */
            .filters-right {
                margin-left: auto;
                margin-top: 2rem;
                display: flex;
                align-items: center;
                gap: 1rem;
            }
            .sort-select {
                border-radius: 1rem;
                padding: 0.5rem 1rem;
                border: 1px solid #ccc;
                font-size: 0.85rem;
                cursor: pointer;
                outline: none;
            }
            .sort-select:focus {
                border-color: #999;
            }
        </style>
        </form>
        <div id="filters">
            <%
            // Filter button definitions — icons + labels matching existing UI
            const filterList = [
                { icon: "fa-solid fa-globe",          label: "All"           },
                { icon: "fa-solid fa-fire",            label: "Trending"      },
                { icon: "fa-solid fa-bed",             label: "Rooms"         },
                { icon: "fa-solid fa-mountain-city",   label: "Cities"        },
                { icon: "fa-solid fa-mountain",        label: "Mountains"     },
                { icon: "fa-solid fa-fort-awesome",    label: "Castles"       },
                { icon: "fa-solid fa-person-swimming", label: "Amazing pools" },
                { icon: "fa-solid fa-campground",      label: "Camping"       },
                { icon: "fa-solid fa-cow",             label: "Farms"         },
                { icon: "fa-solid fa-snowflake",       label: "Arctic"        },
                { icon: "fa-solid fa-igloo",           label: "Domes"         },
                { icon: "fa-solid fa-ship",            label: "Boats"         },
                { icon: "fa-solid fa-person-skiing",   label: "Skiing"        }
            ];
            const activeCategory = category || "All";
            %>
            <% for(let f of filterList) { %>
                <div class="filter <%= activeCategory === f.label ? 'filter-active' : '' %>"
                     data-category="<%= f.label %>">
                    <div><i class="<%= f.icon %>"></i></div>
                    <p><%= f.label %></p>
                </div>
            <% } %>

            <div class="filters-right">
                <select id="sortSelect" class="sort-select">
                    <option value="">Sort by</option>
                    <option value="price_asc"  <%= sort === "price_asc"  ? "selected" : "" %>>Price: Low &rarr; High</option>
                    <option value="price_desc" <%= sort === "price_desc" ? "selected" : "" %>>Price: High &rarr; Low</option>
                    <option value="newest"     <%= sort === "newest"     ? "selected" : "" %>>Newest</option>
                </select>
                <div class="tax-toggle">
                    <div class="form-check-reverse form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
                        <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
                    </div>
                </div>
            </div>
        </div>

        <% if (searchQuery && searchQuery.trim() !== "") { %>
            <div class="mt-3 mb-2">
                <h5>Search results for "<b><%= searchQuery %></b>"
                    <% if (category && category !== "All") { %>
                        in <b><%= category %></b>
                    <% } %>
                    &nbsp;<span class="text-muted" style="font-size:1rem;">(<%= totalCount %> found)</span>
                    <a href="/listings" class="btn btn-sm btn-outline-secondary ms-2">Clear</a>
                </h5>
            </div>
        <% } else if (category && category !== "All") { %>
            <div class="mt-3 mb-2">
                <h5>Category: <b><%= category %></b> &nbsp;
                    <span class="text-muted" style="font-size:1rem;">(<%= totalCount %> found)</span>
                    <a href="/listings" class="btn btn-sm btn-outline-secondary ms-2">Clear</a>
                </h5>
            </div>
        <% } %>

        <% if (allListings.length === 0) { %>
            <div class="text-center mt-5 text-muted">
                <i class="fa-solid fa-magnifying-glass" style="font-size:2.5rem;"></i>
                <h4 class="mt-3">No listings found</h4>
                <p>Try a different search or category. <a href="/listings">View all listings</a>.</p>
            </div>
        <% } else { %>
        <!-- Skeleton loader — visible while page loads, hidden on DOMContentLoaded -->
        <div id="skeleton-grid" class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
            <% for(let i = 0; i < allListings.length; i++) { %>
            <div class="col">
                <div class="skeleton-card">
                    <div class="skeleton-img shimmer"></div>
                    <div class="skeleton-body">
                        <div class="skeleton-line shimmer"></div>
                        <div class="skeleton-line short shimmer"></div>
                    </div>
                </div>
            </div>
            <% } %>
        </div>

        <!-- Real listings — hidden initially, revealed by DOMContentLoaded -->
        <div id="listings-grid" class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1" style="display:none">
            <% for(let listing of allListings){ %>
                <a href="/listings/<%= listing._id %>" class="listing-link">
                    <div class="card col listing-card">
                        <img src="<%= listing.image?.url || listing.image %>" class="card-img-top" alt="listing image"
                            style="height: 20rem;" loading="lazy">
                        <div class="card-img-overlay"></div>
                        <div class="card-body">
                            <p class="card-text">
                                <b>
                                    <%= listing.title %>
                                </b>
                                &#8377; <%= listing.price.toLocaleString("en-IN") %> / night
                                <i class="tax-info"> &nbsp;&nbsp;+18% GST</i>
                            </p>
                        </div>
                    </div>
                </a>
                <% } %>
        </div>

        <%
        // Build a URL for a given page number, preserving current search/category/sort
        function pageUrl(p) {
            let params = [];
            if (searchQuery) params.push("q=" + encodeURIComponent(searchQuery));
            if (category && category !== "All") params.push("category=" + encodeURIComponent(category));
            if (sort) params.push("sort=" + encodeURIComponent(sort));
            params.push("page=" + p);
            return "/listings?" + params.join("&");
        }
        %>
        <% if (totalPages > 1) { %>
        <nav class="mt-4" aria-label="Listings pagination">
            <ul class="pagination justify-content-center">
                <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
                    <a class="page-link" href="<%= pageUrl(page - 1) %>">Previous</a>
                </li>
                <% for(let i = 1; i <= totalPages; i++) { %>
                    <li class="page-item <%= i === page ? 'active' : '' %>">
                        <a class="page-link" href="<%= pageUrl(i) %>"><%= i %></a>
                    </li>
                <% } %>
                <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
                    <a class="page-link" href="<%= pageUrl(page + 1) %>">Next</a>
                </li>
            </ul>
        </nav>
        <% } %>
        <% } %>
        <script>
            // Skeleton loader: swap skeleton → real listings once DOM is ready
            document.addEventListener('DOMContentLoaded', function () {
                var skeletonEl = document.getElementById('skeleton-grid');
                var listingsEl = document.getElementById('listings-grid');
                if (skeletonEl) skeletonEl.style.display = 'none';
                if (listingsEl) listingsEl.style.display = '';
            });

            // Existing: tax toggle
            let taxSwitch = document.getElementById("switchCheckDefault");
            taxSwitch.addEventListener("click", () => {
                let taxInfo = document.getElementsByClassName("tax-info");
                for(info of taxInfo){
                    if(info.style.display!="inline"){
                        info.style.display = "inline";
                    }else{
                        info.style.display = "none";
                    }
                }
            })

            // New: category filter click handlers
            document.querySelectorAll(".filter[data-category]").forEach(function(el) {
                el.addEventListener("click", function() {
                    const cat = this.getAttribute("data-category");
                    const params = new URLSearchParams(window.location.search);
                    if (cat === "All") {
                        params.delete("category");
                    } else {
                        params.set("category", cat);
                    }
                    params.delete("page"); // always reset to page 1 on filter change
                    window.location.href = "/listings?" + params.toString();
                });
            });

            // New: sort dropdown handler
            document.getElementById("sortSelect").addEventListener("change", function() {
                const params = new URLSearchParams(window.location.search);
                if (this.value) {
                    params.set("sort", this.value);
                } else {
                    params.delete("sort");
                }
                params.delete("page"); // always reset to page 1 on sort change
                window.location.href = "/listings?" + params.toString();
            });
        </script>
    </body>